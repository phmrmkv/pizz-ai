---
interface Props {
  rotuloEscuro?: string;
  rotuloClaro?: string;
}

const { rotuloEscuro = 'Mudar para o tema escuro', rotuloClaro = 'Mudar para o tema claro' } = Astro.props;
---

<button
  type="button"
  class="icone-botao"
  aria-label={rotuloEscuro}
  data-tema-botao
  data-rotulo-escuro={rotuloEscuro}
  data-rotulo-claro={rotuloClaro}
>
  <svg class="tema-icone-lua" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="tema-icone-sol" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script>
  const raiz = document.documentElement;
  const botao = document.querySelector<HTMLButtonElement>('[data-tema-botao]');

  if (botao) {
    const sincronizar = () => {
      const escuro = raiz.dataset.theme === 'dark';
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', escuro ? '#1c1209' : '#fbfaf8');
      botao.setAttribute('aria-label', (escuro ? botao.dataset.rotuloClaro : botao.dataset.rotuloEscuro) ?? '');
    };
    sincronizar();
    new MutationObserver(sincronizar).observe(raiz, { attributes: true, attributeFilter: ['data-theme'] });

    botao.addEventListener('click', () => {
      const proximo = raiz.dataset.theme === 'dark' ? 'light' : 'dark';
      raiz.dataset.theme = proximo;
      try {
        localStorage.setItem('pizzai-tema', proximo);
      } catch {
        /* sem armazenamento: a troca vale só nesta visita */
      }
      sincronizar();
    });

    window.addEventListener('storage', (e) => {
      if (e.key === 'pizzai-tema' && (e.newValue === 'dark' || e.newValue === 'light')) raiz.dataset.theme = e.newValue;
    });
  }
</script>
