---
// Logo tipográfico PROVISÓRIO: "Pizz" + um ponto em forma de pizza com uma fatia saindo + "ai".
interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;
---

<span class:list={['logo', classe]}>
  <span aria-hidden="true">Pizz</span>
  <svg class="logo-ponto" aria-hidden="true" viewBox="0 0 24 24" focusable="false">
    <path d="M12 12 L23 12 A11 11 0 1 1 12 1 Z" fill="#f6cf6b" stroke="#d9902f" stroke-width="2.2" stroke-linejoin="round"></path>
    <circle cx="8" cy="9" r="1.7" fill="#cf3f27"></circle>
    <circle cx="9" cy="16" r="1.7" fill="#cf3f27"></circle>
    <circle cx="16" cy="17" r="1.7" fill="#cf3f27"></circle>
    <path class="fatia" d="M14.2 9.8 L14.2 -1 A11 11 0 0 1 25 9.8 Z" fill="#f6cf6b" stroke="#d9902f" stroke-width="2.2" stroke-linejoin="round"></path>
  </svg>
  <span aria-hidden="true">ai</span>
  <span class="sr-only">Pizz.ai</span>
</span>
