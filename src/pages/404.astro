---
import Base from '@/layouts/Base.astro';
---

<Base title="Página não encontrada | Pizz.ai" description="Esta página não existe. Volte para o início da Pizz.ai." noindex base="/">
  <section class="pagina-404">
    <div class="contido">
      <h1>Essa fatia não está aqui.</h1>
      <p>O endereço que você abriu não existe nesta demonstração. Volte ao início para ver como a Pizz.ai monta um pedido.</p>
      <div class="hero-acoes">
        <a class="botao botao-primario" href="/">Voltar ao início</a>
      </div>
    </div>
  </section>
</Base>
