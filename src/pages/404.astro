---
import Base from '@/layouts/Base.astro';
---

<Base title="Página não encontrada | Projeto Pizzaria" description="A página procurada não existe." noindex>
  <section class="mx-auto max-w-xl px-4 py-32 text-center">
    <h1 class="text-4xl font-semibold tracking-tight">Página não encontrada</h1>
    <p class="mt-3 text-muted-foreground">O endereço não existe ou mudou de lugar.</p>
    <a href="/" class="press botao-compra mt-8 inline-flex h-12 items-center rounded-full px-7 font-semibold">Voltar ao cardápio</a>
  </section>
</Base>
